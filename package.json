{
  "name": "inker",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "bun install --cwd backend && bun install --cwd frontend",
    "init": "bun run fonts:init && bun run db:init",
    "fonts:init": "bun run scripts/init-fonts.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:single": "bun run scripts/dev.ts --single",
    "db:init": "bun run --cwd backend db:init",
    "db:push": "bun run --cwd backend prisma:push",
    "db:seed": "bun run --cwd backend prisma:seed",
    "mcp": "bun run --silent --cwd backend mcp",
    "proxy:rpi": "bun run scripts/local/rpi-proxy.ts",
    "proxy:rpi:down": "bun run scripts/local/rpi-proxy.ts --down",
    "build": "bun run --cwd frontend build && bun run --cwd backend build",
    "start": "bun run --cwd backend start:prod"
  }
}
