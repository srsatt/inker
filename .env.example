# Inker Configuration
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# Admin PIN for login (change this!)
ADMIN_PIN="1111"

# SQLite database path, relative to backend/prisma/schema.prisma
DATABASE_URL="file:../data/inker.db"

# Timezone for clock/date widgets
TZ=UTC

# Dev ports: browser/device use 3337; Vite proxies API to backend on 3338.
# `bun run dev:single` ignores PORT and serves everything on 3337.
HOST=127.0.0.1
PORT=3338
VITE_HOST=127.0.0.1
VITE_PORT=3337
VITE_BACKEND_PORT=3338
